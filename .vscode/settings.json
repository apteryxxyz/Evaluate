{
  "cSpell.language": "en-AU",
  "explorer.compactFolders": true,
  "explorer.fileNesting.enabled": true,
  "explorer.fileNesting.patterns": {
    "package.json": "pnpm-lock.yaml, pnpm-workspace.yaml",
    "*.js": "$(capture).js.map, $(capture).d.ts",
    "*.jsx": "$(capture).jsx.map, $(capture).d.ts",
    "*.d.ts": "$(capture).d.ts.map"
  },

  "editor.formatOnSave": true,
  "editor.insertSpaces": true,
  "editor.tabSize": 2,

  "files.associations": {
    "*.css": "tailwindcss",
    ".ffignore": "ignore"
  },
  "material-icon-theme.files.associations": {
    "vite.config.chrome.ts": "vite",
    "vite.config.firefox.ts": "vite"
  },
  "tailwindCSS.classFunctions": ["cn", "cva"],

  "todo-tree.general.tags": ["=====", "TODO"],
  "todo-tree.highlights.customHighlight": {
    "=====": {
      "type": "whole-line",
      "icon": "bookmark",
      "foreground": "#dadada",
      "gutterIcon": true,
      "hideFromTree": true
    },
    "TODO": {
      "type": "whole-line",
      "icon": "check",
      "foreground": "#ff9900",
      "gutterIcon": true
    }
  }
}
